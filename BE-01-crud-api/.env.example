# Database connection string for PostgreSQL
# For running locally on host (against container mapped to port 5433):
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5433/tasks

# For running inside docker compose (container-to-container network):
# DATABASE_URL=postgresql://postgres:dev@db:5432/tasks

# BE-07 LLM provider (OpenRouter free route)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_STUB=1
LLM_ENABLED=true
